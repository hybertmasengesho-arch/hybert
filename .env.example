# Copy this file to .env and fill in real values before running the server.
# cp .env.example .env

# Port the server listens on
PORT=4000

# Any long, random string. Used to sign login tokens — treat it like a password.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of emails that get admin access automatically.
# Add YOUR email here before you register (or log in again after adding it)
# to self-grant admin. Example:
# ADMIN_EMAILS=you@example.com,teammate@example.com
ADMIN_EMAILS=

# Optional — where the SQLite file lives. Defaults to ./data.db if unset.
# DB_PATH=./data.db
